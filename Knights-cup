<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KNIGHTS CUP - Campeonato CS2</title>
    <style>
        :root {
            --bg-dark: #0b0e14;
            --bg-card: #151a23;
            --accent-gold: #f39c12;
            --accent-blue: #00d2ff;
            --text-light: #f1f2f6;
            --text-muted: #a4b0be;
            --discord-color: #5865F2;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        html { scroll-behavior: smooth; }

        body {
            background-color: var(--bg-dark);
            color: var(--text-light);
            line-height: 1.6;
            overflow-x: hidden;
            transition: background-color 0.8s ease;
        }

        /* Header */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 8%;
            background: rgba(11, 14, 20, 0.9);
            backdrop-filter: blur(10px);
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 800;
            letter-spacing: 2px;
            color: var(--accent-gold);
            text-transform: uppercase;
        }

        .logo span { color: var(--accent-blue); }

        nav a {
            color: var(--text-light);
            text-decoration: none;
            margin-left: 20px;
            font-weight: 600;
            transition: 0.3s;
        }

        nav a:hover { color: var(--accent-gold); }

        /* Hero Section com FalleN aperto de mão */
        .hero {
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 0 20px;
            background: linear-gradient(180deg, rgba(11, 14, 20, 0.75) 0%, rgba(11, 14, 20, 1) 100%), 
                        url('https://img.voted.gg/p/o/333/08_br_falle_0d.jpg') center/cover no-repeat;
            margin-top: 60px;
        }

        .hero h1 {
            font-size: 3.8rem;
            text-transform: uppercase;
            letter-spacing: 3px;
            margin-bottom: 10px;
            color: #fff;
            text-shadow: 0 0 20px rgba(0, 210, 255, 0.8);
            animation: pulseGlow 3s infinite alternate;
        }

        .hero p {
            font-size: 1.3rem;
            color: #e0e0e0;
            max-width: 650px;
            margin-bottom: 30px;
            text-shadow: 1px 1px 4px rgba(0,0,0,0.8);
        }

        .btn-discord {
            background-color: var(--discord-color);
            color: #fff;
            padding: 16px 36px;
            font-size: 1.1rem;
            font-weight: bold;
            text-decoration: none;
            border-radius: 6px;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 4px 15px rgba(88, 101, 242, 0.5);
            transition: transform 0.3s, box-shadow 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .btn-discord:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 25px rgba(88, 101, 242, 0.8);
        }

        section { padding: 90px 8%; }

        .section-title {
            text-align: center;
            font-size: 2.2rem;
            margin-bottom: 50px;
            text-transform: uppercase;
            color: var(--accent-gold);
        }

        /* Galeria Interativa */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 20px;
            margin-top: 35px;
        }

        .pro-card {
            position: relative;
            border-radius: 10px;
            overflow: hidden;
            cursor: pointer;
            height: 280px;
            border: 2px solid rgba(255, 255, 255, 0.05);
            transition: all 0.4s ease;
        }

        .pro-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .pro-card-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(0deg, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0) 100%);
            padding: 20px;
            transition: all 0.4s ease;
        }

        .pro-card h4 {
            font-size: 1.3rem;
            color: var(--accent-gold);
            text-transform: uppercase;
        }

        .pro-card p {
            font-size: 0.9rem;
            color: var(--text-light);
        }

        .pro-card:hover {
            transform: translateY(-8px);
            border-color: var(--accent-blue);
            box-shadow: 0 10px 25px rgba(0, 210, 255, 0.3);
        }

        .pro-card:hover img { transform: scale(1.1); }

        /* Grid de Informações */
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
        }

        .card {
            background-color: var(--bg-card);
            padding: 30px;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            text-align: center;
            transition: all 0.4s ease;
        }

        .card:hover {
            border-color: var(--accent-blue);
            transform: translateY(-8px);
            box-shadow: 0 10px 20px rgba(0, 210, 255, 0.2);
        }

        .card h3 {
            font-size: 1.4rem;
            margin-bottom: 15px;
            color: var(--accent-blue);
        }

        .card p { color: var(--text-muted); }

        .highlight-price {
            font-size: 2.5rem;
            color: var(--accent-gold);
            font-weight: bold;
            margin: 15px 0;
        }

        /* Seção Premiação Fiel à Imagem */
        .prize-container {
            display: flex;
            justify-content: center;
            gap: 25px;
            flex-wrap: wrap;
            max-width: 900px;
            margin: 0 auto;
        }

        .prize-card {
            background-color: var(--bg-card);
            padding: 35px 25px;
            border-radius: 10px;
            flex: 1;
            min-width: 300px;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: transform 0.3s ease;
        }

        .prize-card.gold-border {
            border: 1px solid var(--accent-gold);
        }

        .prize-card:hover {
            transform: translateY(-5px);
        }

        .prize-title {
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .prize-title.gold { color: var(--accent-gold); }
        .prize-title.silver { color: #00d2ff; }

        .prize-value {
            font-size: 2.3rem;
            font-weight: 800;
            color: var(--accent-gold);
            margin-bottom: 20px;
        }

        .prize-desc {
            color: var(--text-muted);
            font-size: 0.88rem;
            line-height: 1.4;
        }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            z-index: 2000;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(5px);
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            max-width: 80%;
            max-height: 80vh;
            border-radius: 8px;
            border: 2px solid var(--accent-gold);
            box-shadow: 0 0 30px rgba(0,210,255,0.5);
        }

        .modal-close {
            position: absolute;
            top: 20px;
            right: 30px;
            font-size: 2.5rem;
            color: #fff;
            cursor: pointer;
        }

        /* Passos */
        .steps {
            display: flex;
            flex-direction: column;
            gap: 20px;
            max-width: 800px;
            margin: 0 auto;
        }

        .step-item {
            display: flex;
            align-items: center;
            background: var(--bg-card);
            padding: 20px;
            border-radius: 8px;
            gap: 20px;
            transition: transform 0.3s ease;
        }

        .step-item:hover { transform: translateX(10px); }

        .step-number {
            background: var(--accent-gold);
            color: var(--bg-dark);
            font-weight: bold;
            font-size: 1.5rem;
            width: 50px;
            height: 50px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .reveal {
            opacity: 0;
            transform: translateY(50px);
            transition: all 0.8s ease;
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        @keyframes pulseGlow {
            0% { text-shadow: 0 0 10px rgba(0, 210, 255, 0.5); }
            100% { text-shadow: 0 0 25px rgba(243, 156, 18, 0.9); }
        }

        footer {
            text-align: center;
            padding: 30px;
            background-color: #06080c;
            color: var(--text-muted);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }
    </style>
</head>
<body>

    <header>
        <div class="logo">Knights <span>Cup</span></div>
        <nav>
            <a href="#sobre">Informações</a>
            <a href="#premiacao">Premiação</a>
            <a href="#inscricao">Inscrição</a>
        </nav>
    </header>

    <section class="hero">
        <h1>Knights Cup CS2</h1>
        <p>Fair play, respeito e competição de elite. Monte sua equipe e mostre do que é capaz no cenário profissional!</p>
        <a href="https://discord.gg/DtCrqknBa" target="_blank" class="btn-discord">
            Garantir Vaga no Discord
        </a>
    </section>

    <!-- Informações do Torneio -->
    <section id="sobre" class="reveal">
        <h2 class="section-title">Informações do Torneio</h2>
        <div class="info-grid">
            <div class="card">
                <h3>Plataforma</h3>
                <p><strong>XPlay.GG</strong></p>
                <p>Servidores de Alta Performance e Anticheat Garantido</p>
            </div>
            <div class="card">
                <h3>Formato</h3>
                <p><strong>5v5 Competitivo</strong></p>
                <p>Fase de Grupos + Fase Eliminatória</p>
                <p style="color: var(--accent-gold); font-size: 0.9rem; margin-top: 5px;">🎥 Transmissão Ao Vivo das Partidas</p>
            </div>
            <div class="card">
                <h3>Inscrição</h3>
                <div class="highlight-price">R$ 25,00</div>
                <p>Valor total por equipe (5 Jogadores + Reservas)</p>
            </div>
        </div>

        <!-- Galeria Interativa -->
        <div class="gallery-grid">
            <div class="pro-card" onclick="openModal('https://img.voted.gg/p/o/333/08_br_falle_0d.jpg')">
                <img src="https://img.voted.gg/p/o/333/08_br_falle_0d.jpg" alt="FalleN Handshake">
                <div class="pro-card-overlay">
                    <h4>Espírito Desportivo</h4>
                    <p>Respeito e Cumprimento Entre os Grandes Nomes</p>
                </div>
            </div>
            <div class="pro-card" onclick="openModal('https://images.hltv.org/images/gallery/picture/1647427218.683.jpeg')">
                <img src="https://images.hltv.org/images/gallery/picture/1647427218.683.jpeg" alt="Arena CS2">
                <div class="pro-card-overlay">
                    <h4>Transmissões de Elite</h4>
                    <p>Sinta a Emoção da Arena em Cada Round</p>
                </div>
            </div>
            <div class="pro-card" onclick="openModal('https://images.hltv.org/images/gallery/picture/1636287313.1166.jpeg')">
                <img src="https://images.hltv.org/images/gallery/picture/1636287313.1166.jpeg" alt="Glória do Campeonato">
                <div class="pro-card-overlay">
                    <h4>Buscar a Glória</h4>
                    <p>Suba ao Pódio e Escreva Sua História</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Premiação Fiel à Imagem -->
    <section id="premiacao" class="reveal">
        <h2 class="section-title">PREMIAÇÃO</h2>
        <div class="prize-container">
            <!-- 1º Lugar -->
            <div class="prize-card gold-border">
                <div class="prize-title gold">🥇 1º Lugar - Campeão</div>
                <div class="prize-value">R$ 250,00</div>
                <div class="prize-desc">
                    Premiação em dinheiro direto via PIX + Destaque oficial de campeão.
                </div>
            </div>
            <!-- 2º Lugar -->
            <div class="prize-card">
                <div class="prize-title silver">🥈 2º Lugar - Vice</div>
                <div class="prize-value">Vaga Garantida</div>
                <div class="prize-desc">
                    Inscrição 100% gratuita para disputar a próxima edição da Knights Cup.
                </div>
            </div>
        </div>
    </section>

    <!-- Inscrição -->
    <section id="inscricao" class="reveal">
        <h2 class="section-title">Como Fazer a Inscrição</h2>
        <div class="steps">
            <div class="step-item">
                <div class="step-number">1</div>
                <div>
                    <h4>Acesse nosso Discord Oficial</h4>
                    <p>Entre no servidor do campeonato clicando no botão abaixo.</p>
                </div>
            </div>
            <div class="step-item">
                <div class="step-number">2</div>
                <div>
                    <h4>Abra um Ticket de Inscrição</h4>
                    <p>Vá até a aba de inscrições e abra um chamado privado com a organização.</p>
                </div>
            </div>
            <div class="step-item">
                <div class="step-number">3</div>
                <div>
                    <h4>Efetue o PIX de R$ 25,00</h4>
                    <p>Envie o comprovante de pagamento e os dados do seu time para confirmar sua vaga.</p>
                </div>
            </div>
        </div>

        <div style="text-align: center; margin-top: 40px;">
            <a href="https://discord.gg/DtCrqknBa" target="_blank" class="btn-discord">
                Inscrever Minha Equipe
            </a>
        </div>
    </section>

    <!-- Modal para Zoom -->
    <div id="imageModal" class="modal" onclick="closeModal()">
        <span class="modal-close">&times;</span>
        <img id="modalImg" class="modal-content" src="">
    </div>

    <footer>
        <p>&copy; 2026 KNIGHTS CUP - Todos os direitos reservados.</p>
    </footer>

    <script>
        // Animação de Scroll
        window.addEventListener('scroll', revealOnScroll);

        function revealOnScroll() {
            const reveals = document.querySelectorAll('.reveal');
            for (let i = 0; i < reveals.length; i++) {
                const windowHeight = window.innerHeight;
                const elementTop = reveals[i].getBoundingClientRect().top;
                const elementVisible = 120;

                if (elementTop < windowHeight - elementVisible) {
                    reveals[i].classList.add('active');
                }
            }
        }
        revealOnScroll();

        // Modal
        function openModal(imgSrc) {
            document.getElementById('modalImg').src = imgSrc;
            document.getElementById('imageModal').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('imageModal').style.display = 'none';
        }
    </script>
</body>
</html>
